# Copy to .env — never commit the real file. All values are testnet (chain 10143).
# Chain / RPC
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# Contracts (filled by contracts/script/Deploy.s.sol -> shared/deployments.json)
REGISTRY_ADDR=
FACTORY_ADDR=
UNI_ROUTER_ADDR=
UNI_FACTORY_ADDR=

# Agent (Render background worker)
AGENT_OPERATOR_KEY=
AGENT_API_KEY=
HERMES_URL=https://hermes.pyth.network

# API (Render web service)
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
SQLITE_PATH=./vesta.db
